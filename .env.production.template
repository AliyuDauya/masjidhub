# ==============================================================================
# MasjidHub Production Environment Template
# Per Developer Guide §12.2 (System Overview & Deployment Specs)
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Ports
PORT=5000
FRONTEND_PORT=3000

# Security & Sessions (MANDATORY - server will fail to start if empty)
# Generate using: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_long_random_secret_in_production

# Database Connection (SQLite or PostgreSQL)
# For SQLite file mount:
DATABASE_URL="file:./masjidhub.db"
# For PostgreSQL (if scaling):
# DATABASE_URL="postgresql://user:password@localhost:5432/masjidhub?schema=public"

# Cross-Origin Whitelist (CORS) - Comma-separated list of authorized domains
# Wildcards are strictly rejected in production per Developer Guide §8
ALLOWED_ORIGINS=https://masjidhub.app,https://admin.masjidhub.app

# Frontend Public API URL
NEXT_PUBLIC_API_URL=https://api.masjidhub.app

# Payment Gateway (Optional / Live Paystack Keys)
PAYSTACK_SECRET_KEY=sk_live_replace_with_real_key
PAYSTACK_PUBLIC_KEY=pk_live_replace_with_real_key
